includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:

    paths:
        - app/

    # Level 10 is the highest level
    level: 9

    ignoreErrors:
        # Larastan types unsigned columns as int<0, max> when writing, but reads a
        # model's own key back as a plain int, so every foreign-key assignment trips.
        # This one stays: it is a tooling artefact, not a suppressed defect.
        -   '#^Property App\\Models\\\w+\:\:\$\w+ \(int<0, max>(\|null)?\) does not accept int(\|null)?\.$#'

    # The null-safety patterns that used to live here — "Cannot access property on
    # Model|null", "Cannot call method on Model|null", and null passed where a User
    # or Model is required — are exactly the diagnostics level 9 exists to produce.
    # Suppressed by regex they applied to every model in the application, so new
    # violations landed silently. They now sit in phpstan-baseline.neon instead:
    # the existing count is frozen and anything new fails the build.

    treatPhpDocTypesAsCertain: false
    checkExplicitMixed: false

    editorUrl: 'phpstorm://open?file=%%file%%&line=%%line%%'
